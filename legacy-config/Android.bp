// Preserve paths compiled into legacy consumers; contents remain vendor-owned.

install_symlink {
    name: "htc_m8_config_link_bluetooth_cal_acdb",
    installed_location: "etc/Bluetooth_cal.acdb",
    symlink_target: "/vendor/etc/Bluetooth_cal.acdb",
}

