# set_torch_mode opens /sys/class/leds/torch_0/brightness: search on the
# sysfs_leds class directory, the torch_0 link, search on the sysfs_flashlight
# device directory, then the write.
allow hal_camera_default sysfs_leds:dir search;
allow hal_camera_default sysfs_leds:lnk_file read;
allow hal_camera_default sysfs_flashlight:dir search;
allow hal_camera_default sysfs_flashlight:file w_file_perms;
